<!doctype html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/project.css">
        <script src="https://code.jquery.com/jquery-4.0.0.js"></script>
    </head>
    <body class="login-hero">
        <div class="auth-wrapper">
            <div class="auth-card">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                    <img src="/images/bag.png" style="width:48px;height:48px;" />
                    <div>
                        <h2>Welcome back</h2>
                        <p class="lead">Sign in to manage your Gifteria dashboard</p>
                    </div>
                </div>

                <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert alert-danger" role="alert"><%= message %></div>
                <% } %>

                <form action="/admin/chk_login" method="post">
                    <div class="mb-3 form-floating">
                        <input class="form-control" type="text" placeholder=" " name="emailid" autocomplete="new-password" />
                        <label>Email address / Mobile</label>
                    </div>

                    <div class="mb-3 form-floating">
                        <input class="form-control" type="password" placeholder=" " name="password" autocomplete="new-password" />
                        <label>Password</label>
                    </div>

                    <div class="d-flex align-items-center justify-content-start mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember">
                            <label class="form-check-label" for="remember">Remember me</label>
                        </div>
                    </div>

                    <div class="auth-actions">
                        <button type="submit" class="btn btn-login">🎁 Login In</button>
                    </div>
                </form>

                <p style="margin-top:18px;color:rgba(255,255,255,0.7);">Find the perfect gift for every special moment.</p>
            </div>

            <div class="illustration-card">
                <img src="/images/gifts.png" alt="illustration"/>
            </div>
        </div>
    </body>
</html>
    