

<html>
    <head>
        <link rel="stylesheet" href="/stylesheets/project.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Oswald:wght@200..700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="https://code.jquery.com/jquery-4.0.0.js"></script>
        <script src="/javascripts/gift_data.js"></script>
    </head>
    <body class="dashboard-page">
        <div class="dashboard-layout">
            <aside class="dashboard-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo">
                        <img src="/images/bag.png" alt="Gifteria logo" width="46" />
                        <div>
                            <h1>Gifteria</h1>
                            <p>Gift inventory & store control</p>
                        </div>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <a class="sidebar-link active" href="/admin/dashboard">
                        <img src="/images/dashboard.png" alt="Dashboard" />
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar-link" href="/product/product_interface" target="mw">
                        <img src="/images/add-cart.png" alt="New Products" />
                        <span>New Products</span>
                    </a>
                    <a class="sidebar-link" href="/product/fetch_all_products" target="mw">
                        <img src="/images/check.png" alt="Product List" />
                        <span>Product List</span>
                    </a>
                    <a class="sidebar-link" href="/product/search_by_id" target="mw">
                        <img src="/images/loupe.png" alt="Search Product" />
                        <span>Search Product</span>
                    </a>
                    <a class="sidebar-link" href="/admin/logout">
                        <img src="/images/exit-door.png" alt="Logout" />
                        <span>Logout</span>
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <p>Administrator</p>
                    <strong><%= data.adminname %></strong>
                </div>
            </aside>

            <main class="dashboard-main">
                <header class="dashboard-header">
                    <div>
                        <span class="eyebrow">Product Management</span>
                        <h2>Product Dashboard</h2>
                        <p class="dashboard-intro">A professional control center for your Gifteria product catalog, quick actions, and daily performance metrics.</p>
                    </div>
                    <div class="user-summary">
                        <img src="/images/<%= data.picture %>" alt="Admin profile" />
                        <div>
                            <span>Signed in as</span>
                            <strong><%= data.adminname %></strong>
                        </div>
                    </div>
                </header>

                <section class="dashboard-metrics">
                    <article class="metric-card accent-1">
                        <span class="metric-title">Total Products</span>
                        <strong>1,250</strong>
                        <small>Items currently in the store</small>
                    </article>
                    <article class="metric-card accent-2">
                        <span class="metric-title">Categories</span>
                        <strong>25</strong>
                        <small>Active product categories</small>
                    </article>
                    <article class="metric-card accent-3">
                        <span class="metric-title">Today's Orders</span>
                        <strong>146</strong>
                        <small>Recent order entries</small>
                    </article>
                    <article class="metric-card accent-4">
                        <span class="metric-title">Revenue</span>
                        <strong>₹85K</strong>
                        <small>Estimate based on live sales</small>
                    </article>
                </section>
